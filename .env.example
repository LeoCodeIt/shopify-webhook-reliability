# Shopify webhook secret — found in your Shopify Partner dashboard or app settings
# Never commit the real value. Use a test value for local development.
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret-here

# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/webhook_db

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Idempotency key TTL in seconds
# Should exceed the webhook retry window. Verify current Shopify retry window
# in documentation before adjusting this value.
IDEMPOTENCY_TTL_SECONDS=172800

# Worker configuration
MAX_RETRY_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=2

# Replay endpoint — protect with a strong secret in production
# This endpoint must not be accessible from the public internet
REPLAY_API_KEY=change-this-in-production

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Application environment: development, staging, production
ENVIRONMENT=development
